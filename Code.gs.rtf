  const orderId = order['Order ID'];\
  const statusEmoji = newStatus === 'Paid' ? '\uc0\u9989 ' : '\u55357 \u56550 ';\
  const subject = `$\{statusEmoji\} Order $\{orderId\} Update \'96 Nex4UpStore`;\
  const body = `\
Dear $\{order['Customer Name'] || 'Valued Customer'\},\
\
Your order ($\{orderId\}) has been updated to **$\{newStatus\}**.\
\
Order Details:\
- Items: $\{order['Items']\}\
- Total: RM $\{parseFloat(order['Total (RM)'] || 0).toFixed(2)\}\
