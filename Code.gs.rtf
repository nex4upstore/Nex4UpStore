function addGame(data) \{\
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(GAME_SHEET_NAME);\
  if (!sheet) \{ setupSheet(); \}\
  const sh = SpreadsheetApp.openById(SHEET_ID).getSheetByName(GAME_SHEET_NAME);\
  const ids = sh.getRange('A:A').getValues().flat().filter(v => typeof v === 'number' && v > 0);\
  const nextId = ids.length ? Math.max(...ids) + 1 : 1;\
  const additionalImagesStr = data.additionalImages ? data.additionalImages.split(',').map(s => s.trim()).filter(s => s).join(', ') : '';\
\
  // \uc0\u9989  Handle variant data\
  const productType = (data.productType || 'digital').toString().toLowerCase();\
  const requiresShipping = (data.requiresShipping === true || data.requiresShipping === 'yes') ? 'yes' : 'no';\
  const hasVariants = (data.hasVariants === true || data.hasVariants === 'yes') ? 'yes' : 'no';\
  const variantOptions = Array.isArray(data.variantOptions) ? JSON.stringify(data.variantOptions) : '[]';\
  const variants = Array.isArray(data.variants) ? JSON.stringify(data.variants) : '[]';\
\
  const row = [\
    nextId,\
    data.title,\
    data.category || 'General',\
    parseFloat(data.price) || 0,\
    parseFloat(data.cost) || 0,\
    parseFloat(data.discount) || 0,\
    parseInt(data.quantity) || 0,\
    data.description || '',\
    data.image || '',\
    data.badge || '',\
    additionalImagesStr,\
    (data.gameType || 'roblox').toString().toLowerCase(),\
    productType,\
    requiresShipping,\
    hasVariants,\
    variantOptions,\
    variants\
  ];\
  sh.appendRow(row);\
  return getGamesData();\
\}\
