    const data = sheet.getDataRange().getValues();\
    const reviews = [];\
    for (let i = 1; i < data.length; i++) \{\
      const row = data[i];\
      if (!row[0]) continue;\
      if (String(row[1]) !== String(gameId)) continue;\
