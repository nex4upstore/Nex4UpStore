// ============================================================\
// \uc0\u9989  PAYMENT QR CODES (from Drive folder)\
// ============================================================\
function getPaymentQRs() \{\
  try \{\
    const folder = DriveApp.getFolderById(QR_FOLDER_ID);\
    const files = folder.getFiles();\
    const result = \{\};\
    while (files.hasNext()) \{\
      const file = files.next();\
      const originalName = file.getName();\
      const name = originalName.toLowerCase();\
      const mime = file.getMimeType();\
\
      if (mime.indexOf('image/') !== 0) continue;\
\
      const blob = file.getBlob();\
      const base64 = Utilities.base64Encode(blob.getBytes());\
      let key = null;\
\
      if (name.indexOf('mae') !== -1) \{\
        key = 'mae';\
      \} else if (name.indexOf('tng') !== -1) \{\
        key = 'tng';\
      \} else if (name.indexOf('shopee') !== -1) \{\
        key = 'shopee';\
      \}\
\
      if (key) \{\
        result[key] = 'data:' + mime + ';base64,' + base64;\
      \}\
    \}\
    Logger.log('\uc0\u9989  Loaded QRs: ' + Object.keys(result).join(', '));\
    return result;\
  \} catch (e) \{\
    Logger.log('\uc0\u10060  getPaymentQRs error: ' + e.message);\
    return \{\};\
  \}\
\}\
