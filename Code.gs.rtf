// \uc0\u55357 \u56561  TELEGRAM NOTIFICATIONS (with invisible-char protection)\
// ============================================================\
function sendTelegramNotification(message) \{\
  try \{\
    // \uc0\u9989  STRIP every non-printable ASCII character (spaces, BOM, zero-width, etc.)\
    var token  = String(TELEGRAM_BOT_TOKEN || '').replace(/[^\\x21-\\x7E]/g, '');\
    var chatId = String(TELEGRAM_CHAT_ID   || '').replace(/[^\\-\\d]/g, '');\
\
    if (!token || !chatId) \{\
      Logger.log('\uc0\u9888 \u65039  Telegram not configured.');\
      return \{ success: false, message: 'Not configured' \};\
    \}\
\
    var url = 'https://api.telegram.org/bot' + token + '/sendMessage';\
    var options = \{\
      method: 'post',\
      payload: \{\
        chat_id: chatId,\
        text: message,\
        parse_mode: 'HTML',\
        disable_web_page_preview: true\
      \},\
      muteHttpExceptions: true\
    \};\
\
    var response = UrlFetchApp.fetch(url, options);\
    var status = response.getResponseCode();\
    if (status === 200) \{\
      Logger.log('\uc0\u9989  Telegram sent');\
      return \{ success: true \};\
    \} else \{\
      Logger.log('\uc0\u10060  Telegram failed: ' + response.getContentText());\
      return \{ success: false, message: response.getContentText() \};\
    \}\
  \} catch (e) \{\
    Logger.log('\uc0\u10060  sendTelegramNotification error: ' + e.message);\
    return \{ success: false, message: e.message \};\
  \}\
\}\
