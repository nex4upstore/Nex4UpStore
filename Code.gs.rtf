// \uc0\u9989  Escape HTML special chars for Telegram's HTML parse mode\
function escapeTelegramHtml(s) \{\
  if (s === null || s === undefined) return '';\
  return String(s)\
    .replace(/&/g, '&amp;')\
    .replace(/</g, '&lt;')\
    .replace(/>/g, '&gt;');\
\}}